@article{wang2026pertura_claim,
  abbr        = {Under Review},
  bibtex_show = {true},
  title       = {Knowing When to Claim: Pertura for Execution-Grounded Claim Promotion in Perturb-seq Agents},
  author      = {Wang, Tianyi},
  journal     = {Submitted to AAAI 2027},
  year        = {2026},
  selected    = {true},
  annotation  = {Under review},
  abstract    = {An execution-grounded authority layer that gates every scientific claim made by an LLM agent on verified execution, analysis scope, and upstream dependencies. On PerturaBench (20 dependency-aware tasks over three Perturb-seq datasets), it reaches 83.3% primary scientific fidelity versus 44.4% and 38.9% for baselines, and 82.5% claim-authority success with no loss of informativeness.}
}

